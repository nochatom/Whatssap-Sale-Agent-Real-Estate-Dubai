DATABASE_URL=
ANTHROPIC_API_KEY=
# qwen | cloudflare | anthropic | gemini — which AI provider generates WhatsApp replies. Defaults to qwen if unset.
AI_PROVIDER=
# Primary provider — a TokenRouter (api.tokenrouter.com) API key, an
# OpenAI-compatible aggregator proxying the qwen/qwen3.8-max-free model. Any
# failure automatically falls back to Cloudflare (CLOUDFLARE_ACCOUNT_ID /
# CLOUDFLARE_API_TOKEN below), so both should be set together in production.
QWEN_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Free-tier-only fallback for the Claude (anthropic) primary path — used
# automatically when Claude fails for any reason (quota/rate-limit/
# exhausted credits/timeout/other error). Must be a key from a Google Cloud
# project with NO billing account linked; whether any given key can incur
# a charge is entirely a property of that project's configuration, not
# something this app can detect or enforce.
GEMINI_API_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANGUAGE=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
TRIGGER_SECRET_KEY=
# Private operator-only Telegram alert (send-telegram-notification task) for
# the payment_confirmed / ready_to_start milestones — never sent to the
# customer, entirely separate from the WhatsApp send path. Bot token from
# @BotFather; chat ID is the operator's own Telegram chat. Missing/invalid
# values only ever fail this one notification, never the WhatsApp reply.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
