DATABASE_URL=
ANTHROPIC_API_KEY=
# AI_PROVIDER is NOT read anywhere in src/skill/invoke.ts — the routing
# chain (Gemini -> Qwen -> Cloudflare) always runs regardless of this
# value. Left here only because other tooling/docs may still reference it;
# do not rely on it to pin a single provider.
AI_PROVIDER=
# Primary provider — Google's Gemini Developer API (aistudio.google.com).
# Any failure automatically falls back to Qwen, then Cloudflare, so all
# three should be set together in production. If this key's Google Cloud
# project has a billing account linked, real usage volume now runs through
# it as the PRIMARY provider (not an occasional fallback) — confirm billing
# status before relying on "free tier" assumptions; this app cannot detect
# or enforce that from the client side.
GEMINI_API_KEY=
# Fallback — a TokenRouter (api.tokenrouter.com) API key, an
# OpenAI-compatible aggregator proxying the qwen/qwen3.8-max-free model.
QWEN_API_KEY=
# Terminal fallback.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANGUAGE=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
TRIGGER_SECRET_KEY=
# Private operator-only Telegram alert (send-telegram-notification task) for
# the payment_confirmed / ready_to_start milestones — never sent to the
# customer, entirely separate from the WhatsApp send path. Bot token from
# @BotFather; chat ID is the operator's own Telegram chat. Missing/invalid
# values only ever fail this one notification, never the WhatsApp reply.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
